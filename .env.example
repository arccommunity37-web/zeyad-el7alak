# ==============================
# متغيرات البيئة - انسخ الملف ده وسميه .env واملى القيم الحقيقية
# ==============================

# البورت اللي السيرفر هيشتغل عليه
PORT=5000

# رابط الاتصال بقاعدة بيانات MongoDB (لوكال أو Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/barbershop

# مفتاح سري لتوقيع الـ JWT Token (غيّره لأي نص عشوائي طويل)
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# بيانات حساب Cloudinary (لرفع صور القصات والمنتجات) - هتلاقيها في Dashboard بتاعك في cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
